# LLM API Keys - comma-separated, at least 2 keys
# Key ids are assigned as key_1, key_2, ... in order
LLM_API_KEYS=your-api-key-1,your-api-key-2

# LLM Model to use (LiteLLM format)
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite database location
DATABASE_URL=sqlite:////data/app.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable failure simulation header (set to true for testing)
ENABLE_FAILURE_SIMULATION=true

# Default system prompt (optional)
DEFAULT_SYSTEM_PROMPT=You are a helpful AI assistant.
